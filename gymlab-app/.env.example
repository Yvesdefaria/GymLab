# Telemetría anónima (F93 #27) — deja estos valores vacíos para desactivarla.
# Copia este archivo como `.env` y rellena con tus claves reales.
# Las claves solo se usan en build de producción (`npm run build`); en dev la
# telemetría permanece desactivada.

# Project key de PostHog (https://us.posthog.com/project/.../settings)
VITE_POSTHOG_PROJECT_KEY=

# DSN de Sentry (https://sentry.io/settings/projects/<project>/keys/)
VITE_SENTRY_DSN=